# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Screenplays are authored and delivered in Fountain
*.[fF][dD][xX]

# Full treatment remains local until explicitly approved for public publication
/source/MEMENTO MORI.txt
